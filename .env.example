# Sayt manzili (oxirida / siz)
NEXT_PUBLIC_SITE_URL=https://sizning-domen.uz

# ── Meta Pixel + Conversions API ──
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
# Purchase valyutasi (ISO kod): USD yoki UZS
META_CURRENCY=USD
# Ixtiyoriy: shahar (CAPI "ct" maydoni uchun), masalan: samarkand
META_CITY=
# Faqat test paytida (Events Manager → Test events kodi), keyin o'chiring
META_TEST_EVENT_CODE=
META_API_VERSION=v24.0

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=
# Bir nechta chat bo'lsa vergul bilan: -1001234567890,123456789
TELEGRAM_CHAT_IDS=
# Faqat A-Z a-z 0-9 _ - belgilar, 20+ belgi
TELEGRAM_WEBHOOK_SECRET=

# ── Upstash Redis (lid ma'lumotlarini saqlash) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
