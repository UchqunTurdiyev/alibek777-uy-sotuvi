# Sayt manzili (oxirida / siz)
NEXT_PUBLIC_SITE_URL=https://sizning-domen.uz

# ── Meta Pixel + Conversions API ──
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
# Purchase valyutasi (ISO kod): USD yoki UZS
META_CURRENCY=USD
# Ixtiyoriy: shahar (CAPI "ct" maydoni uchun), masalan: samarkand
META_CITY=
# Faqat test paytida (Events Manager → Test events kodi), keyin o'chiring
META_TEST_EVENT_CODE=
META_API_VERSION=v24.0

# Rahmat sahifasidan 10 soniyada o'tiladigan havola (kanal, guruh yoki bot)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/Alibek777_TJM

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=
# Bir nechta chat bo'lsa vergul bilan: -1001234567890,123456789
TELEGRAM_CHAT_IDS=
# Faqat A-Z a-z 0-9 _ - belgilar, 20+ belgi
TELEGRAM_WEBHOOK_SECRET=

# ── MongoDB (lidlar va CRM ma'lumotlari) ──
# Atlas → Database → Connect → Drivers → connection string
MONGODB_URI=mongodb+srv://USER:PAROL@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=alibek777

# ── CRM paneli (/crm) ──
# Menejerlar kiradigan parol
CRM_PASSWORD=
# Ixtiyoriy: sessiya imzosi uchun uzun tasodifiy satr (bo'lmasa CRM_PASSWORD ishlatiladi)
CRM_SECRET=
